{
  "name": "xplora-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:vite\"",
    "dev:vite": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "test": "node --import tsx --test server/tests/custom-email-template.test.ts tests/custom-email-template-preview.test.ts",
    "typecheck:tests": "tsc -p server/tsconfig.tests.json && tsc -p tsconfig.tests.json",
    "build": "tsc && vite build && npm run build:server",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "cross-env NODE_ENV=production node dist-server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kyncode/sdk": "^0.1.3",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.99.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "gsap": "^3.15.0",
    "helmet": "^8.0.0",
    "jose": "^6.2.9",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
